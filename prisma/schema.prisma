  receiver_id                                    String?        @db.Uuid
  room_url                                       String
  type                                           String
  status                                         String
  created_at                                     DateTime?      @default(now()) @db.Timestamptz(6)
  ended_at                                       DateTime?      @db.Timestamptz(6)
  user_profiles_calls_caller_idTouser_profiles   user_profiles? @relation("calls_caller_idTouser_profiles", fields: [caller_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  conversations                                  conversations? @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_profiles_calls_receiver_idTouser_profiles user_profiles? @relation("calls_receiver_idTouser_profiles", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
