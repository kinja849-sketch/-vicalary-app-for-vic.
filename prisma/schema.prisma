/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model companies {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String        @unique
  subsidiaries      String[]      @default([])
  invest_israel     Boolean?      @default(false)
  invest_uae        Boolean?      @default(false)
  notes             String?
  created_at        DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?     @default(now()) @db.Timestamptz(6)
  parent_company_id String?       @db.Uuid
  country_of_origin String?
  us_affiliated     Boolean?      @default(false)
  israel_affiliated Boolean?      @default(false)
  uae_affiliated    Boolean?      @default(false)
  ownership_pct     Decimal?      @db.Decimal
  affiliation_type  String?
  justification     String?
  data_sources      String[]
  enrichment_status String?       @default("pending")
  aliases           String[]
  companies         companies?    @relation("companiesTocompanies", fields: [parent_company_id], references: [id], onUpdate: NoAction)
  other_companies   companies[]   @relation("companiesTocompanies")
  medications       medications[]
  products          products[]

  @@index([aliases], map: "idx_companies_aliases_gin", type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], map: "idx_companies_name_gin_trgm", type: Gin)
