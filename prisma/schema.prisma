generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model budget_transactions {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  budget_id        String?       @db.Uuid
  food_analysis_id String?       @db.Uuid
  amount           Decimal       @db.Decimal
  description      String?
  transaction_date DateTime?     @default(now()) @db.Timestamptz(6)
  user_budgets     user_budgets? @relation(fields: [budget_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([budget_id, transaction_date(sort: Desc)], map: "idx_budget_transactions_budget")
}

