/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_recipe_interactions {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String?        @db.Uuid
  recipe_id        String?        @db.Uuid
  interaction_type String
  rating           Int?
  notes            String?
  interacted_at    DateTime?      @default(now()) @db.Timestamptz(6)
  recipes          recipes?       @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_profiles    user_profiles? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, recipe_id, interaction_type])
  @@index([user_id, interacted_at(sort: Desc)], map: "idx_recipe_interactions_user")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_settings {
  id                         String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                    String         @unique @db.Uuid
  theme                      String?        @default("light")
  push_notifications_enabled Boolean?       @default(true)
  language                   String?        @default("en")
  currency                   String?        @default("USD")
  timezone                   String?
  subscription_status        String?        @default("free")
  subscription_expires_at    DateTime?      @db.Timestamptz(6)
  created_at                 DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime?      @default(now()) @db.Timestamptz(6)
  country_code               String?
  is_language_auto           Boolean?       @default(true)
  last_quran_index           Int?           @default(1)
  last_hadith_index          Int?           @default(1)
  user_profiles              user_profiles? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_spiritual_history {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String?            @db.Uuid
  content_id        String?            @db.Uuid
  viewed_at         DateTime?          @default(now()) @db.Timestamptz(6)
  spiritual_content spiritual_content? @relation(fields: [content_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_profiles     user_profiles?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
